---
// Poster award winners: a celebratory block at the top of the Posters page.
import awards from "../data/poster-awards.json";
import posters from "../data/posters.json";

const byId = new Map(posters.map((p) => [p.id, p]));
const label = (id: string) => `P${id.padStart(2, "0")}`;
const placeName: Record<number, string> = { 1: "1st Place", 2: "2nd Place", 3: "3rd Place" };
const medal: Record<number, string> = { 1: "🥇", 2: "🥈", 3: "🥉" };
---
<section class="awards" id="awards" aria-labelledby="awards-heading">
  <div class="awards-hero">
    <p class="awards-eyebrow">BBSW 2026 Poster Awards</p>
    <h2 id="awards-heading" class="awards-title">Congratulations to our winners!</h2>
    <p class="awards-sub">Thank you to every presenter for sharing your work, and to everyone who stopped by and voted.</p>
  </div>

  {awards.map((cat) => {
    const firstTied = cat.winners.filter((w) => w.place === 1).length > 1;
    return (
      <div class="award-cat">
        <h3 class="cat-name"><span aria-hidden="true">🏆</span> {cat.name}</h3>
        <p class="cat-blurb">{cat.blurb}</p>
        <ol class="winners">
          {cat.winners.map((w) => {
            const p = byId.get(w.poster)!;
            return (
              <li class={`winner place-${w.place}`}>
                <span class="medal" aria-hidden="true">{medal[w.place]}</span>
                <div class="winner-body">
                  <span class="winner-place">{placeName[w.place]}{w.place === 1 && firstTied ? " (tie)" : ""}</span>
                  <span class="winner-name">{p.presenters}</span>
                  <span class="winner-aff">{w.affiliation}</span>
                  <a class="winner-title" href={`#poster-${w.poster}`}>{label(w.poster)} · {p.title}</a>
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    );
  })}
</section>

<style>
  .awards {
    margin: 0 0 2rem;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid #ecd9b0;
    background: var(--color-surface-warm, #faf8f3);
    box-shadow: 0 10px 28px rgba(155, 27, 48, 0.1);
  }
  .awards-hero {
    padding: 1.75rem 1.25rem 1.5rem;
    text-align: center;
    color: #fff;
    background:
      radial-gradient(120% 90% at 100% 0%, #c42a44 0%, transparent 60%),
      linear-gradient(160deg, #9b1b30 0%, #5a0f1c 100%);
  }
  .awards-eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f7d39b;
  }
  .awards-title {
    margin: 0;
    color: #fff;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 6.5vw, 2rem);
    line-height: 1.15;
  }
  .awards-sub { margin: 0.6rem auto 0; max-width: 32rem; font-size: 0.92rem; color: #f5c6cb; line-height: 1.45; }

  .award-cat { padding: 1.4rem 1.1rem 0.4rem; }
  .award-cat + .award-cat { border-top: 1px solid #ecd9b0; }
  .cat-name {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--color-primary);
  }
  .cat-blurb { margin: 0.2rem 0 1rem; font-size: 0.85rem; color: var(--color-muted); }

  .winners { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .winner {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 0.95rem 1rem;
    background: #fff;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    border-left: 5px solid #cbd5e1;
  }
  .winner.place-1 { border-left-color: #d4a017; background: linear-gradient(90deg, #fff8e1 0%, #fff 70%); }
  .winner.place-2 { border-left-color: #9ca3af; }
  .winner.place-3 { border-left-color: #b4713c; }
  .winners .winner:last-child { margin-bottom: 1rem; }
  .medal { font-size: 2rem; line-height: 1; flex: none; }
  .winner-body { display: flex; flex-direction: column; min-width: 0; }
  .winner-place {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8a6d1d;
  }
  .winner-name { margin-top: 0.1rem; font-family: var(--font-serif); font-size: 1.25rem; font-weight: 700; color: var(--color-text); }
  .winner-aff { font-size: 0.88rem; color: var(--color-muted); }
  .winner-title { margin-top: 0.4rem; font-size: 0.88rem; line-height: 1.4; color: var(--color-primary); }
</style>
