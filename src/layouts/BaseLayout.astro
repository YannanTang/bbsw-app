---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "BBSW 2026", description = "Bay Area Biotech-Pharma Statistics Workshop 2026" } = Astro.props;
const base = import.meta.env.BASE_URL;
const link = (p: string) => `${base}${p}`.replace(/\/\//g, "/");

// Detect current top-level slug to highlight the active tab.
const baseClean = base.replace(/\/$/, "");
const path = Astro.url.pathname;
const slug = path.replace(baseClean, "").replace(/^\//, "").split("/")[0] || "";

const slugToTab: Record<string, string> = {
  "home": "home",
  "schedule": "schedule",
  "sessions": "schedule",
  "posters": "posters",
  "sponsors": "sponsors",
  "venue": "venue",
  "install": "",
};
const currentTab = slugToTab[slug] ?? "schedule";

// Privacy-friendly page counts (goatcounter.com). Leave empty to disable.
const GOATCOUNTER_CODE = "";

const tabs = [
  { slug: "home", href: link("home"), label: "Home" },
  { slug: "schedule", href: link("schedule"), label: "Schedule" },
  { slug: "posters", href: link("posters"), label: "Posters" },
  { slug: "sponsors", href: link("sponsors"), label: "Sponsors" },
  { slug: "venue", href: link("venue"), label: "Venue" },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#9b1b30" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={link("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={link("apple-touch-icon.png")} />
    <link rel="manifest" href={link("manifest.webmanifest")} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="BBSW 2026" />
    <meta name="mobile-web-app-capable" content="yes" />
  </head>
  <body>
    <header class="site-header">
      <a href={link("home")} class="brand" aria-label="BBSW 2026 home">
        <img src={link("bbsw-logo.webp")} alt="BBSW — Bay Area Biotech-Pharma Statistics Workshop" />
        <span class="brand-text">2026</span>
      </a>
      <a class="site-link" href="https://bbsw.org" target="_blank" rel="noopener" aria-label="Visit bbsw.org (opens in a new tab)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>
        <span>bbsw.org</span>
        <svg class="site-link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
      </a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>BBSW 2026 · November 5–6, 2026 · Foster City, CA</p>
      <p><a href={link("install")}>Add the app to your phone</a> · <a href="https://bbsw.org">bbsw.org</a></p>
    </footer>
    {slug !== "install" && (
      <div class="install-banner" id="install-banner" hidden>
        <img src={link("icon-192.png")} alt="" width="40" height="40" />
        <div class="install-banner-text">
          <strong>Add BBSW 2026 to your home screen</strong>
          <span id="install-banner-hint">One tap to the schedule, works offline.</span>
        </div>
        <button type="button" class="install-banner-action" id="install-banner-action">Install</button>
        <button type="button" class="install-banner-close" id="install-banner-close" aria-label="Dismiss">×</button>
      </div>
    )}
    <nav class="tab-bar" aria-label="Primary">
      {tabs.map((t) => (
        <a href={t.href} class={t.slug === currentTab ? "active" : ""} aria-current={t.slug === currentTab ? "page" : undefined}>
          <span class="tab-icon-bg">
            {t.slug === "home" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10l9-7 9 7v10a1 1 0 0 1-1 1h-5v-8H9v8H4a1 1 0 0 1-1-1V10z"/></svg>
            )}
            {t.slug === "schedule" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>
            )}
            {t.slug === "posters" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg>
            )}
            {t.slug === "sponsors" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            )}
            {t.slug === "venue" && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s-7-7.5-7-13a7 7 0 0 1 14 0c0 5.5-7 13-7 13z"/><circle cx="12" cy="9" r="2.5"/></svg>
            )}
          </span>
          <span>{t.label}</span>
        </a>
      ))}
    </nav>
    <script is:inline define:vars={{ swPath: link("sw.js"), swScope: base, installHref: link("install") }}>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register(swPath, { scope: swScope }).catch(() => {});
        });
      }

      // Install guidance: phones only, never for people who already installed or dismissed it.
      (function () {
        var DISMISS_KEY = "bbsw_install_dismissed";
        var ua = navigator.userAgent;
        var isIOS = /iPhone|iPad|iPod/.test(ua) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
        var isAndroid = /Android/.test(ua);
        var inApp = /FBAN|FBAV|Instagram|LinkedInApp|MicroMessenger|Line\/|GSA\/|; wv\)/.test(ua);
        var standalone = window.matchMedia("(display-mode: standalone)").matches || navigator.standalone === true;
        var banner = document.getElementById("install-banner");
        function hide() { if (banner) banner.hidden = true; }
        function remember() { try { localStorage.setItem(DISMISS_KEY, "1"); } catch (_) {} }

        // Capture Chrome's install prompt so any page (banner or /install) can trigger it.
        // Chrome only fires this when the app is NOT installed.
        window.addEventListener("beforeinstallprompt", function (e) {
          e.preventDefault();
          window.bbswInstallPrompt = e;
          window.dispatchEvent(new Event("bbsw:installable"));
        });
        window.addEventListener("appinstalled", function () { remember(); hide(); });

        // Running as the installed app: remember it (Android shares this with Chrome).
        if (standalone) { remember(); return; }
        if (!banner || !(isIOS || isAndroid)) return;
        try { if (localStorage.getItem(DISMISS_KEY)) return; } catch (_) {}

        var hint = document.getElementById("install-banner-hint");
        var action = document.getElementById("install-banner-action");
        document.getElementById("install-banner-close").onclick = function () { remember(); hide(); };
        function goHelp() { location.href = installHref; }

        if (inApp) {
          hint.textContent = "First open this page in Safari or Chrome.";
          action.textContent = "How?";
          action.onclick = goHelp;
          banner.hidden = false;
        } else if (isIOS) {
          // iOS can't report whether the app is installed; closing the banner hides it for good.
          hint.innerHTML = 'Tap <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="Share"><path d="M12 3v12M8 7l4-4 4 4"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></svg> Share, then \u201cAdd to Home Screen\u201d.';
          action.textContent = "Help";
          action.onclick = goHelp;
          banner.hidden = false;
        } else {
          // Android: show only when Chrome says the app is installable (i.e. not yet installed).
          function show() {
            action.textContent = "Install";
            action.onclick = function () {
              var evt = window.bbswInstallPrompt;
              if (!evt) return;
              evt.prompt();
              evt.userChoice.then(function (c) { if (c.outcome === "accepted") remember(); })
                .finally(function () { window.bbswInstallPrompt = null; hide(); });
            };
            banner.hidden = false;
          }
          if (window.bbswInstallPrompt) show();
          window.addEventListener("bbsw:installable", show);
        }
      })();
    </script>
    {GOATCOUNTER_CODE && (
      <script is:inline async data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`} src="//gc.zgo.at/count.js"></script>
    )}
  </body>
</html>
