---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
const link = (p: string) => `${base}${p}`.replace(/\/\//g, "/");
---
<BaseLayout title="BBSW 2026 — Home">
  <section class="hero">
    <h1>BBSW 2026</h1>
    <p class="theme">"The Adaptive Data Scientist: From Data to Impact"</p>
    <p><strong>November 5–6, 2026 · Foster City, CA</strong></p>
  </section>

  <h2>Using this app</h2>
  <p><a href={link("schedule")}>Schedule</a> is your main guide to the two-day program — tap any session to see the abstract and speaker details.</p>
  <p><a href={link("posters")}>Posters</a> lists all accepted poster presentations.</p>
  <p><a href={link("sponsors")}>Sponsors</a> recognizes the organizations that make BBSW possible.</p>
  <p><a href={link("venue")}>Venue</a> has everything you need on-site: location, parking, hotel, and Wi-Fi.</p>
</BaseLayout>

<style>
  .theme {
    font-size: 1.1rem;
    font-style: italic;
    color: var(--teal, #00a5b5);
    margin: 0.25rem 0 0.75rem;
  }
</style>
