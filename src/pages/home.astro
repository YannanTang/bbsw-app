---
import BaseLayout from "../layouts/BaseLayout.astro";
import sessions from "../data/sessions.json";
import speakers from "../data/speakers.json";

const base = import.meta.env.BASE_URL;
const link = (p: string) => `${base}${p}`.replace(/\/\//g, "/");

type Speaker = { id: string; name: string; title: string; affiliation: string; photo: string; };
type Talk = { speakers: string[]; };
type Session = { id: string; title: string; talks: Talk[]; };

const speakerMap = new Map((speakers as Speaker[]).map((speaker) => [speaker.id, speaker]));
const keynotes = (sessions as Session[])
  .filter((session) => session.id.startsWith("keynote-"))
  .map((session) => ({
    session,
    speaker: speakerMap.get(session.talks[0]?.speakers[0] ?? ""),
  }))
  .filter((keynote) => keynote.speaker);
---
<BaseLayout title="BBSW 2026 — Home">
  <section class="hero">
    <p class="eyebrow">2026 Bay Area Biotech-Pharma Statistics Workshop</p>
    <h1>BBSW 2026</h1>
    <p class="theme">"The Adaptive Data Scientist: From Data to Impact"</p>
    <p><strong>November 5–6, 2026 · Foster City, CA</strong></p>
  </section>

  <section class="keynote-section" aria-labelledby="keynote-heading">
    <div class="section-heading">
      <p class="eyebrow">Featured plenaries</p>
      <h2 id="keynote-heading">Keynote speakers</h2>
      <p>Hear how adaptive data science turns complex evidence into meaningful impact.</p>
    </div>
    <div class="keynote-grid">
      {keynotes.map(({ session, speaker }) => (
        <a class="keynote-card" href={link(`sessions/${session.id}`)}>
          <img src={speaker.photo || link("speaker-placeholder.svg")} alt={speaker.name} />
          <div class="keynote-content">
            <span class="tag accent">{session.title.replace(/:.*/, "")}</span>
            <h3>{speaker.name}</h3>
            <p>{speaker.title}{speaker.title && speaker.affiliation ? " · " : ""}{speaker.affiliation}</p>
            <span class="profile-link">View keynote</span>
          </div>
        </a>
      ))}
    </div>
  </section>

</BaseLayout>

<style>
  .eyebrow {
    margin: 0 0 0.45rem;
    color: var(--color-secondary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero .eyebrow {
    color: #f7d39b;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  .theme {
    max-width: 34rem;
    font-size: 1.45rem;
    font-style: italic;
    color: #fff;
    line-height: 1.3;
    margin: 0.25rem 0 0.75rem;
  }

  .keynote-section {
    margin: 2rem 0 2.25rem;
  }

  .section-heading h2 {
    margin-top: 0;
    margin-bottom: 0.35rem;
  }

  .section-heading > p:last-child {
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  .keynote-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .keynote-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface-warm);
    color: var(--color-text);
  }

  .keynote-card:hover {
    border-color: var(--color-primary);
    text-decoration: none;
  }

  .keynote-card img {
    width: 76px;
    height: 76px;
    flex: 0 0 auto;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .keynote-content h3 {
    margin: 0.4rem 0 0.15rem;
  }

  .keynote-content p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .profile-link {
    display: inline-block;
    margin-top: 0.55rem;
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 600;
  }

</style>
