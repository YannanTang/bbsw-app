---
import BaseLayout from "../layouts/BaseLayout.astro";
import posters from "../data/posters.json";

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Posters — BBSW 2026">
  <h1>Poster Sessions</h1>
  <p>Lightning talks and poster viewing take place during the conference.</p>

  <div class="poster-list mt-8">
    <h2 class="mb-4">Accepted Posters</h2>
    {posters.map((p) => (
      <div class="poster-card mb-6 p-4 border rounded-lg bg-white shadow-sm">
        <div class="text-sm font-bold text-gray-500 mb-1">Poster {p.id}</div>
        <h3 class="text-xl font-bold leading-snug">{p.title}</h3>
        <div class="text-gray-700 mt-2 font-medium">{p.presenters} · {p.affiliation}</div>
        <details class="mt-3 group">
          <summary class="cursor-pointer text-blue-600 font-semibold list-none">Read Abstract ▼</summary>
          <div class="mt-2 text-sm text-gray-600 leading-relaxed">{p.abstract}</div>
        </details>
      </div>
    ))}
  </div>
</BaseLayout>
