---
import BaseLayout from "../layouts/BaseLayout.astro";
import posters from "../data/posters.json";

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Posters — BBSW 2026">
  <h1>Poster Sessions</h1>
  <p>Lightning talks and voting take place during the conference.</p>

  <section class="voting-box">
    <h2>Vote for the Best Poster</h2>
    <p class="privacy-note">Your information is only collected to verify registration and ensure one ballot per attendee. It will not be shared or disclosed.</p>
    
    <form id="voting-form" class="space-y-4">
      <div class="field">
        <label for="voter-name">Full Name</label>
        <input type="text" id="voter-name" name="name" required />
      </div>
      <div class="field">
        <label for="voter-email">Registration Email</label>
        <input type="email" id="voter-email" name="email" required />
      </div>
      
      <div class="field">
        <label>Select up to 3 posters:</label>
        <div class="checkbox-grid">
          {posters.map((p) => (
            <label class="checkbox-label">
              <input type="checkbox" name="posters" value={p.id} />
              <span class="poster-summary">
                <strong>Poster {p.id}: {p.presenters}</strong><br/>
                <span class="poster-title-small">{p.title}</span>
              </span>
            </label>
          ))}
        </div>
      </div>

      <div id="vote-message" class="message hidden"></div>
      <button type="submit" id="submit-btn" class="cta">Submit Ballot</button>
    </form>
  </section>

  <div class="poster-list mt-8">
    <h2 class="mb-4">Accepted Posters</h2>
    {posters.map((p) => (
      <div class="poster-card mb-6 p-4 border rounded-lg bg-white shadow-sm">
        <div class="text-sm font-bold text-gray-500 mb-1">Poster {p.id}</div>
        <h3 class="text-xl font-bold leading-snug">{p.title}</h3>
        <div class="text-gray-700 mt-2 font-medium">{p.presenters} · {p.affiliation}</div>
        <details class="mt-3 group">
          <summary class="cursor-pointer text-blue-600 font-semibold list-none">Read Abstract ▼</summary>
          <div class="mt-2 text-sm text-gray-600 leading-relaxed">{p.abstract}</div>
        </details>
      </div>
    ))}
  </div>
</BaseLayout>

<script>
  // PASTE YOUR GOOGLE APPS SCRIPT WEB APP URL HERE:
  const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxtXHkaiTcEa1ikGyRAWPz80G0iLr5wtUbtdsPoABbS60HUHMnQM9RUl2xiEDU7NXlB6A/exec";
  
  const form = document.getElementById("voting-form") as HTMLFormElement;
  const msgBox = document.getElementById("vote-message") as HTMLDivElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const selected = formData.getAll("posters");
    
    if (selected.length < 1 || selected.length > 3) {
      showMessage("Please select between 1 and 3 posters.", "error");
      return;
    }
    
    btn.disabled = true;
    btn.textContent = "Submitting...";
    msgBox.className = "message hidden";
    
    const payload = {
      name: formData.get("name"),
      email: formData.get("email"),
      votes: selected
    };
    
    try {
      const response = await fetch(SCRIPT_URL, {
        method: "POST",
        body: JSON.stringify(payload)
      });
      
      const result = await response.json();
      
      if (result.success) {
        showMessage(result.message, "success");
        form.reset();
      } else {
        showMessage(result.message, "error");
      }
    } catch (err) {
      showMessage("Network error. Please try again.", "error");
    } finally {
      btn.disabled = false;
      btn.textContent = "Submit Ballot";
    }
  });

  function showMessage(text: string, type: "success" | "error") {
    msgBox.textContent = text;
    msgBox.className = `message ${type}`;
  }
</script>

<style>
  .voting-box { background: #f8fafc; padding: 1.5rem; border-radius: 12px; margin-bottom: 2.5rem; border: 1px solid #e2e8f0; }
  .privacy-note { font-size: 0.85rem; color: #64748b; margin-bottom: 1.5rem; font-style: italic; }
  .field { margin-bottom: 1.25rem; }
  .field label { display: block; font-weight: 600; margin-bottom: 0.5rem; font-size: 0.95rem; }
  .field input[type="text"], .field input[type="email"] { width: 100%; padding: 0.6rem; border: 1px solid #cbd5e1; border-radius: 6px; }
  .checkbox-grid { display: flex; flex-direction: column; gap: 0.75rem; }
  .checkbox-label { display: flex; gap: 0.75rem; align-items: flex-start; cursor: pointer; padding: 0.75rem; background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; transition: border-color 0.2s; }
  .checkbox-label:hover { border-color: #94a3b8; }
  .poster-summary { font-size: 0.9rem; line-height: 1.4; }
  .poster-title-small { color: #475569; font-size: 0.85rem; }
  .message { padding: 0.75rem; border-radius: 6px; margin-bottom: 1rem; font-weight: 600; font-size: 0.9rem; }
  .message.hidden { display: none; }
  .message.error { background: #fee2e2; color: #b91c1c; border: 1px solid #fca5a5; }
  .message.success { background: #dcfce3; color: #166534; border: 1px solid #86efac; }
  .cta { width: 100%; padding: 0.75rem; background: var(--color-primary, #9b1b30); color: #fff; font-weight: 700; border: none; border-radius: 8px; cursor: pointer; font-size: 1rem; }
  .cta:disabled { opacity: 0.6; cursor: not-allowed; }
</style>
