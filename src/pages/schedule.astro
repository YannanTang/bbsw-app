---
import BaseLayout from "../layouts/BaseLayout.astro";
import sessions from "../data/sessions.json";
import speakers from "../data/speakers.json";
import sponsors from "../data/sponsors.json";
import raffle from "../data/raffle.json";

const base = import.meta.env.BASE_URL;
const link = (p: string) => `${base}${p}`.replace(/\/\//g, "/");

type Talk = {
  id: string; title: string; startTime: string; endTime: string;
  abstract: string; speakers: string[];
};
type Session = {
  id: string; title: string; track: string; date: string;
  startTime: string; endTime: string; room: string; description: string;
  chairs: string[]; talks: Talk[];
  sponsor?: string;
};
type Speaker = { id: string; name: string; title: string; affiliation: string; bio: string; photo: string; linkedin: string; };

const speakerMap = new Map((speakers as Speaker[]).map((sp) => [sp.id, sp]));
const sponsorMap = new Map((sponsors as { id: string; name: string; logo: string }[]).map((sp) => [sp.id, sp]));
const raffleDays = raffle.sessions as Record<string, { day: string; date: string }>;
const names = (ids: string[]) => ids.map((id) => speakerMap.get(id)?.name).filter(Boolean).join(", ");

const all = sessions as Session[];
const scheduled = all.filter((s) => s.date);
const unscheduled = all.filter((s) => !s.date);

const parseTime = (t: string) => {
  const m = t.match(/(\d+):(\d+)\s*(AM|PM)/i);
  if (!m) return Number.POSITIVE_INFINITY; // TBA sorts last within the day
  let h = parseInt(m[1], 10) % 12;
  if (m[3].toUpperCase() === "PM") h += 12;
  return h * 60 + parseInt(m[2], 10);
};

const byDate: Record<string, Session[]> = {};
for (const s of scheduled) (byDate[s.date] ||= []).push(s);
for (const d of Object.keys(byDate)) byDate[d].sort((a, b) => parseTime(a.startTime) - parseTime(b.startTime));
const days = Object.keys(byDate).sort();

const dayLabel = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric" });
// Day 0 is the Nov 4 workshop; the main conference is Day 1 (Nov 5) and Day 2 (Nov 6).
const dayNum = (iso: string) => Math.round((Date.parse(iso) - Date.parse("2026-11-05")) / 86_400_000) + 1;
const dayWeekday = (iso: string) => new Date(iso + "T00:00:00").toLocaleDateString("en-US", { weekday: "short" });
const dayDate = (iso: string) => new Date(iso + "T00:00:00").toLocaleDateString("en-US", { month: "short", day: "numeric" });

const timeLabel = (s: Session) => (s.startTime ? `${s.startTime}${s.endTime ? `–${s.endTime}` : ""}${s.room ? ` · ${s.room}` : ""}` : "Time to be announced");

// Sessions sharing the same date + start time run in parallel (attendee picks one track).
type Slot = { time: string; sessions: Session[] };
const groupSlots = (list: Session[]): Slot[] => {
  const slots: Slot[] = [];
  for (const s of list) {
    const last = slots[slots.length - 1];
    if (s.startTime && last && last.sessions[0].startTime === s.startTime) {
      last.sessions.push(s);
    } else {
      slots.push({ time: s.startTime, sessions: [s] });
    }
  }
  return slots;
};
---
<BaseLayout title="Schedule — BBSW 2026">
  <h1>Schedule</h1>
  <p>The 2026 program is being finalized. Session times and talks will appear here as they are confirmed.</p>

  {days.length > 1 && (
    <nav class="day-bar" aria-label="Jump to day">
      {days.map((d, i) => (
        <a href={`#day-${d}`} class:list={["day-tab", { active: i === 0 }]} data-day={d}>
          <span class="day-num">Day {dayNum(d)}</span> · <span class="day-weekday">{dayWeekday(d)}, </span>{dayDate(d)}
        </a>
      ))}
    </nav>
  )}

  {days.map((d) => (
    <details class="day-group" id={`day-${d}`} open>
      <summary class="day-summary">
        <h2 class="day-heading">{dayLabel(d)}</h2>
        <span class="chevron" aria-hidden="true">▾</span>
      </summary>
      <div class="day-content">
        {groupSlots(byDate[d]).map((slot) =>
          slot.sessions.length > 1 ? (
            <div class="parallel-slot">
              <div class="slot-time">
                {slot.time}–{slot.sessions[0].endTime}
                <span class="tag accent">Parallel — choose one</span>
              </div>
              <div class="parallel-grid">
                {slot.sessions.map((s) => (
                  <a class="session-row parallel-card" href={link(`sessions/${s.id}`)}>
                    <div class="title">{s.title}</div>
                    {s.track && <span class="tag">{s.track}</span>}
                    {s.room && <div class="meta">{s.room}</div>}
                    {s.chairs.length > 0 && <div class="meta">Chair{s.chairs.length > 1 ? "s" : ""}: {names(s.chairs)}</div>}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a class="session-row" href={link(`sessions/${slot.sessions[0].id}`)}>
              <div class="time">{timeLabel(slot.sessions[0])}</div>
              {raffleDays[slot.sessions[0].id] && (
                <span class="tag primary raffle-live" data-day={raffleDays[slot.sessions[0].id].day} data-date={raffleDays[slot.sessions[0].id].date} data-endpoint={raffle.endpoint} hidden>Raffle sign-up open — tap to enter</span>
              )}
              <div class="title-row">
                <div class="title">{slot.sessions[0].title}</div>
                {slot.sessions[0].sponsor && sponsorMap.get(slot.sessions[0].sponsor) && (
                  <img class="sponsor-logo" src={link(sponsorMap.get(slot.sessions[0].sponsor)!.logo)} alt={`Sponsored by ${sponsorMap.get(slot.sessions[0].sponsor)!.name}`} />
                )}
              </div>
              {slot.sessions[0].track && <span class="tag">{slot.sessions[0].track}</span>}
              {slot.sessions[0].chairs.length > 0 && (
                <div class="meta">
                  Chair{slot.sessions[0].chairs.length > 1 ? "s" : ""}: {names(slot.sessions[0].chairs)}
                </div>
              )}
            </a>
          )
        )}
      </div>
    </details>
  ))}

  {unscheduled.length > 0 && (
    <details class="day-group" open>
      <summary class="day-summary">
        <h2 class="day-heading">Unscheduled Sessions</h2>
        <span class="chevron" aria-hidden="true">▾</span>
      </summary>
      <div class="day-content">
        {unscheduled.map((s) => (
          <a class="session-row" href={link(`sessions/${s.id}`)}>
            <div class="title">{s.title}</div>
            {s.track && <span class="tag">{s.track}</span>}
            {s.chairs.length > 0 && <div class="meta">Chair{s.chairs.length > 1 ? "s" : ""}: {names(s.chairs)}</div>}
          </a>
        ))}
      </div>
    </details>
  )}
</BaseLayout>

<script>
  // Flag the raffle session while the stage has sign-up open (asked only on the raffle day).
  const tick = () => {
    const today = new Date().toLocaleDateString("en-CA", { timeZone: "America/Los_Angeles" });
    document.querySelectorAll<HTMLElement>(".raffle-live").forEach((el) => {
      const { day, date, endpoint } = el.dataset;
      if (!endpoint || date !== today) return;
      fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body: JSON.stringify({ action: "state", day }),
      })
        .then((r) => r.json())
        .then((st) => { el.hidden = !st.open; })
        .catch(() => {});
    });
  };
  tick();
  setInterval(tick, 30_000);

  // Day bar: highlight the day being read; tapping a day opens it if collapsed.
  const bar = document.querySelector<HTMLElement>(".day-bar");
  if (bar) {
    const tabs = [...bar.querySelectorAll<HTMLAnchorElement>(".day-tab")];
    const groups = tabs.map((t) => document.getElementById(`day-${t.dataset.day}`) as HTMLDetailsElement);
    const update = () => {
      const line = bar.getBoundingClientRect().bottom + 8;
      let current = 0;
      groups.forEach((g, i) => { if (g.getBoundingClientRect().top <= line) current = i; });
      tabs.forEach((t, i) => t.classList.toggle("active", i === current));
    };
    tabs.forEach((t, i) => t.addEventListener("click", () => { groups[i].open = true; }));
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update);
    update();
  }
</script>

<style>
  .raffle-live { margin: 0.25rem 0; }
  .raffle-live[hidden] { display: none; }
  .day-bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    gap: 0.25rem;
    margin: 0 -1rem 0.5rem;
    padding: 0.35rem 1rem;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--color-border);
  }
  .day-tab {
    flex: 1;
    min-width: 0;
    text-align: center;
    padding: 0.3rem 0.5rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .day-tab.active {
    background: var(--color-primary);
    color: #fff;
  }
  .day-num { font-weight: 700; }
  @media (max-width: 480px) {
    .day-tab { font-size: 0.8rem; padding: 0.3rem 0.25rem; }
    .day-weekday { display: none; }
  }
  .day-group {
    margin-bottom: 1.5rem;
    scroll-margin-top: 3rem;
  }
  .day-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
    user-select: none;
    padding: 0.5rem 0;
  }
  .day-summary::-webkit-details-marker {
    display: none;
  }
  .day-heading {
    margin: 0;
  }
  .chevron {
    font-size: 1.25rem;
    color: var(--color-muted, #666);
    transition: transform 0.2s ease;
    display: inline-block;
  }
  .day-group[open] .chevron {
    transform: rotate(180deg);
  }
  .day-content {
    margin-top: 0.75rem;
  }
</style>
