---
import BaseLayout from "../../layouts/BaseLayout.astro";
import speakers from "../../data/speakers.json";
import sessions from "../../data/sessions.json";

const base = import.meta.env.BASE_URL;
const link = (p: string) => `${base}${p}`.replace(/\/\//g, "/");

type Speaker = { id: string; name: string; title: string; affiliation: string; bio: string; photo: string; linkedin: string; };
type Talk = { id: string; title: string; startTime: string; endTime: string; abstract: string; speakers: string[]; };
type Session = { id: string; title: string; track: string; date: string; startTime: string; endTime: string; room: string; description: string; chairs: string[]; talks: Talk[]; };

export async function getStaticPaths() {
  const data = (await import("../../data/speakers.json")).default as Speaker[];
  return data.map((sp) => ({ params: { id: sp.id }, props: { speaker: sp } }));
}

const { speaker } = Astro.props as { speaker: Speaker };
const theirSessions = (sessions as Session[])
  .map((s) => {
    const roles: string[] = [];
    if (s.chairs.includes(speaker.id)) roles.push("Chair");
    const talkTitles = s.talks.filter((t) => t.speakers.includes(speaker.id)).map((t) => t.title);
    if (talkTitles.length) roles.push("Speaker");
    return { session: s, roles, talkTitles };
  })
  .filter((x) => x.roles.length > 0);

const timeLabel = (s: Session) => [s.date, s.startTime && `${s.startTime}–${s.endTime}`, s.room].filter(Boolean).join(" · ");
---
<BaseLayout title={`${speaker.name} — BBSW 2026`}>
  <a class="back-link" href={link("speakers")}>← Back to speakers</a>
  <div class="speaker-card" style="background:#fff;">
    <img src={speaker.photo || link("speaker-placeholder.svg")} alt={speaker.name} style="width:96px;height:96px;" />
    <div>
      <h1 style="margin:0 0 0.25rem;">{speaker.name}</h1>
      <div class="meta">{speaker.title}{speaker.affiliation ? ` · ${speaker.affiliation}` : ""}</div>
      {speaker.linkedin && <div style="margin-top:0.35rem;"><a href={speaker.linkedin}>LinkedIn</a></div>}
    </div>
  </div>

  {speaker.bio && (
    <>
      <h2>About</h2>
      <p>{speaker.bio}</p>
    </>
  )}

  {theirSessions.length > 0 && (
    <>
      <h2>Sessions</h2>
      {theirSessions.map(({ session: s, roles, talkTitles }) => (
        <a class="session-row" href={link(`sessions/${s.id}`)}>
          {timeLabel(s) && <div class="time">{timeLabel(s)}</div>}
          <div class="title">{s.title}</div>
          {s.track && <span class="tag">{s.track}</span>}
          <span class="tag accent">{roles.join(" · ")}</span>
          {talkTitles.length > 0 && <div class="meta">{talkTitles.join("; ")}</div>}
        </a>
      ))}
    </>
  )}
</BaseLayout>
