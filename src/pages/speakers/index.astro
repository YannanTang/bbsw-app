---
import BaseLayout from "../../layouts/BaseLayout.astro";
import speakers from "../../data/speakers.json";
import SpeakerCard from "../../components/SpeakerCard.astro";

type Speaker = { id: string; name: string; title: string; affiliation: string; bio: string; photo: string; linkedin: string; };
const list = (speakers as Speaker[]).slice().sort((a, b) => a.name.localeCompare(b.name));
---
<BaseLayout title="Speakers — BBSW 2026">
  <h1>Speakers</h1>
  <p>Session chairs and speakers for BBSW 2026. More will be added as the program is confirmed.</p>
  <div class="grid">
    {list.map((sp) => (
      <SpeakerCard sp={sp} withSessions />
    ))}
  </div>
</BaseLayout>
