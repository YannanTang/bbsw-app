---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const link = (p: string) => `${base}${p}`.replace(/\/\//g, "/");

type Sponsor = { id: string; name: string; tier: string; logo?: string; website?: string; description?: string; };

export async function getStaticPaths() {
  const data = (await import("../../data/sponsors.json")).default as Sponsor[];
  return data.map((sp) => ({ params: { id: sp.id }, props: { sponsor: sp } }));
}

const { sponsor } = Astro.props as { sponsor: Sponsor };

// Only link out to a real http(s) URL; anything else renders no button.
const website = /^https?:\/\/\S+$/i.test(sponsor.website?.trim() ?? "") ? sponsor.website!.trim() : "";

// Description is plain text: blank lines separate paragraphs, lines starting with "• " are list items.
type Block = { kind: "p"; lines: string[] } | { kind: "ul"; items: string[] };
const blocks: Block[] = [];
for (const chunk of (sponsor.description ?? "").split(/\n\s*\n/)) {
  let current: Block | undefined; // consecutive lines of the same kind within a chunk share one block
  for (const raw of chunk.split("\n")) {
    const line = raw.trim();
    if (!line) continue;
    if (line.startsWith("• ")) {
      if (current?.kind !== "ul") blocks.push((current = { kind: "ul", items: [] }));
      current.items.push(line.slice(2));
    } else {
      if (current?.kind !== "p") blocks.push((current = { kind: "p", lines: [] }));
      current.lines.push(line);
    }
  }
}
---
<BaseLayout title={`${sponsor.name} — BBSW 2026`}>
  <a class="back-link" href={link("sponsors")}>← Back to sponsors</a>
  <div class="sponsor-detail-header">
    {sponsor.logo && (
      <div class="sponsor-detail-logo">
        <img src={link(sponsor.logo)} alt={`${sponsor.name} logo`} />
      </div>
    )}
    {/* The logo carries the name visually; keep the heading for screen readers, or visible when there is no logo. */}
    <h1 class={sponsor.logo ? "visually-hidden" : undefined}>{sponsor.name}</h1>
    {sponsor.tier && <span class="tag primary">{sponsor.tier} Sponsor</span>}
  </div>

  {blocks.length > 0 && (
    <div class="sponsor-description">
      {blocks.map((b) =>
        b.kind === "ul"
          ? <ul>{b.items.map((item) => <li>{item}</li>)}</ul>
          : <p>{b.lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>
      )}
    </div>
  )}

  {website && (
    <p>
      <a class="sponsor-website" href={website} target="_blank" rel="noopener" aria-label={`Visit the ${sponsor.name} website (opens in a new tab)`}>
        Visit website
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
      </a>
    </p>
  )}
</BaseLayout>
