---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Venue — BBSW 2026">
  <h1>Venue &amp; Logistics</h1>
  <p><strong>Foster City, CA · November 5–6, 2026</strong></p>

  <div class="card">
    <h2 style="margin-top:0;">Wi-Fi</h2>
    <ul>
      <li><strong style="display:inline;">Network</strong>: <code>IHGWIFI.COM</code></li>
      <li><strong style="display:inline;">Access code</strong>: <code>SFOFC</code></li>
    </ul>
  </div>

  <div class="card">
    <h2 style="margin-top:0;">Location</h2>
    <p><strong>Crowne Plaza Foster City–San Mateo</strong><br />1221 Chess Drive<br />Foster City, CA 94404</p>
    <p><a href="https://www.google.com/maps/search/?api=1&query=Crowne+Plaza+Foster+City+San+Mateo+1221+Chess+Drive+Foster+City+CA+94404">Open in Google Maps</a> · <a href="https://maps.apple.com/?q=Crowne+Plaza+Foster+City&address=1221+Chess+Drive,+Foster+City,+CA+94404">Apple Maps</a></p>
  </div>

  <div class="card">
    <h2 style="margin-top:0;">Floor Map</h2>
    <a href="/venue-floor-plan.jpg" target="_blank" rel="noopener" aria-label="Open the floor map full size">
      <img src="/venue-floor-plan.jpg" width="1448" height="1086" loading="lazy" alt="Hotel floor map showing the Magellan, Marco Polo, Syracuse and Stanford rooms" style="width:100%;height:auto;border-radius:8px;background:#fff;" />
    </a>
    <p class="meta">Tap the map to open it full size.</p>
    <ul>
      <li><strong style="display:inline;">Magellan</strong>: main conference room (plenary sessions and the "a" parallel sessions)</li>
      <li><strong style="display:inline;">Marco Polo</strong>: "b" parallel sessions (1b, 2b, 3b, 4b)</li>
      <li><strong style="display:inline;">Stanford</strong>: poster session</li>
      <li><strong style="display:inline;">Syracuse</strong>: breakfast and lunch buffet</li>
    </ul>
  </div>

  <div class="card">
    <h2 style="margin-top:0;">Parking</h2>
    <p>Free self-parking at the hotel.</p>
  </div>

</BaseLayout>
